<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/canvasuplifter/db" VERSION="20260611" COMMENT="Canvas Uplifter schema"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_canvasuplifter_jobs" COMMENT="One row per Canvas-to-Moodle build run.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Admin who started the build."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" DEFAULT="queued"
               COMMENT="queued | running | done | failed."/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"
               COMMENT="Course category the new course will be created in."/>
        <FIELD NAME="fileid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"
               COMMENT="ID of the stored package file in the Moodle file API."/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"
               COMMENT="The created course's id, or NULL if not built yet."/>
        <FIELD NAME="report" TYPE="text" NOTNULL="false" SEQUENCE="false"
               COMMENT="JSON-encoded build report (counts, warnings, items skipped)."/>
        <FIELD NAME="errormsg" TYPE="text" NOTNULL="false" SEQUENCE="false"
               COMMENT="Failure detail when status = failed."/>
        <FIELD NAME="progress" TYPE="int" LENGTH="3" NOTNULL="true" SEQUENCE="false" DEFAULT="0"
               COMMENT="Percent complete, 0-100. Updated by the adhoc task."/>
        <FIELD NAME="progressmessage" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"
               COMMENT="Free-form status message displayed beside the progress bar."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status_ix" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
